[Unit]
Description=Jarvis Voice Assistant Daemon
After=network.target sound.target

[Service]
Type=simple
ExecStart=/bin/bash JARVIS_REPO_PATH/scripts/jarvis-daemon.sh
WorkingDirectory=JARVIS_REPO_PATH
Restart=on-failure
RestartSec=10
StandardOutput=append:JARVIS_LOG_PATH/jarvis.log
StandardError=append:JARVIS_LOG_PATH/jarvis.error.log

# Allow microphone access
SupplementaryGroups=audio

[Install]
WantedBy=default.target
