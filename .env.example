# Jarvis AI Assistant - Environment Variables
# ============================================
# Copy this file to .env and fill in your API keys

# Google Gemini API (for LLM backend)
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_PROJECT_NAME=

# Mem0 API (for persistent memory)
MEM0_API_KEY=

# ElevenLabs API (for TTS - optional)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Debug settings
# JARVIS_VOICE_DEBUG=1
