# Cartesia (RECOMMENDED - best value: ~$0.02/min, 40ms TTS latency)
# Get API key at: https://cartesia.ai
# Uses: Groq STT + GPT-4o-mini + Cartesia TTS
CARTESIA_API_KEY=sk_car_your_key_here

# Groq (fast STT - required for Cartesia provider, also standalone cheapest option)
# Get free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# OpenAI (GPT-4o-mini for LLM - required for Cartesia provider)
# Get API key at: https://platform.openai.com
OPENAI_API_KEY=sk_your_openai_key_here

# ElevenLabs Conversational AI (best quality, highest cost ~$0.05-0.10/min)
# Create agent at: https://elevenlabs.io
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_agent_id_here
ELEVENLABS_API_KEY=your_api_key_here

# Mem0 Memory (optional - for persistent conversation memory)
# Get free API key at: https://app.mem0.ai
MEM0_API_KEY=your_mem0_key_here

# Picovoice Porcupine (optional - for "Hey Jarvis" wake word detection)
# Get free API key at: https://console.picovoice.ai
PICOVOICE_API_KEY=your_picovoice_key_here
