# ===========================================
# DATABASE (Required for Authentication)
# ===========================================
# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL="postgresql://jarvis:change-me@localhost:5432/jarvis"

# ===========================================
# AUTHENTICATION (Required)
# ===========================================
# NextAuth configuration
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=

# Google OAuth (from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=

# ===========================================
# AI PROVIDERS
# ===========================================

# Cartesia (RECOMMENDED - best value: ~$0.02/min, 40ms TTS latency)
# Get API key at: https://cartesia.ai
# Uses: Groq STT + GPT-4o-mini + Cartesia TTS
CARTESIA_API_KEY=

# Groq (fast STT - required for Cartesia provider, also standalone cheapest option)
# Get free API key at: https://console.groq.com
GROQ_API_KEY=

# ElevenLabs Conversational AI (best quality, highest cost ~$0.05-0.10/min)
# Create agent at: https://elevenlabs.io
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_agent_id_here

# Mem0 API (for persistent memory)
MEM0_API_KEY=

# ElevenLabs API (for TTS - optional, add when ready)
ELEVENLABS_API_KEY=

# OpenAI API (for fast LLM responses)
OPENAI_API_KEY=

PICOVOICE_API_KEY=
